.vscode

# Godot 4.2+ specific ignores
~*.dll

# Godot 4+ specific ignores
.godot/
.nomedia
addons/ffmpeg
model/

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Export outputs
*.exe
# Uncomment if your project does not version PCK files as runtime dependencies.
# *.pck

model/*
settings.tres

.secrets

# CI local build output
builds/

# Godot export templates bundled for CI
!.github/workflows/export templates/*.exe
