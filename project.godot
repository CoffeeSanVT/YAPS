; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

translations_plugin/last_edited_file_path="res://localization/YAPS_Localization.csv"

[application]

config/name="YAPS"
config/version="1.0.0_rc"
run/main_scene="res://scenes/menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="yaps"
config/features=PackedStringArray("4.7", "C#")
run/low_processor_mode=true
boot_splash/bg_color=Color(0.17254902, 0.16862746, 0.1764706, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://b4i12gm186tg0"
config/icon="uid://dyco1qh4mc3g4"
boot_splash/minimum_display_time=1
config/build_number=107

[audio]

buses/default_bus_layout="uid://i2dwp18o17cb"
driver/enable_input=true

[autoload]

ApplicationState="*res://script/global/application_state.gd"
SignalBus="*res://script/global/signal_bus.gd"
Settings="*res://script/global/settings.gd"
AudioSystem="*res://script/global/audio_system.gd"
InputMapper="*res://script/global/input_mapper.gd"
ModelLoader="*res://script/global/model_loader.gd"
WebSocketServer="*res://script/external_connections/websocket_server.gd"
TwitchClient="*res://script/external_connections/twitch_client.gd"
GlobalInput="*uid://dtqvsd027rpqs"
FileLogger="*res://script/global/file_logger.gd"
LoadingOverlay="*res://scenes/loading_overlay.tscn"
ScreenshotCapture="*res://script/global/screenshot_capture.gd"

[copy_files_on_export]

files=Array[PackedStringArray]([PackedStringArray("model")])

[debug]

file_logging/enable_file_logging.pc=false
gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false
window/size/transparent=true
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="YAPS"

[editor_plugins]

enabled=PackedStringArray("res://addons/csvedit/plugin.cfg", "res://addons/global_input/plugin.cfg", "res://addons/localization_apply/plugin.cfg")

[input]

