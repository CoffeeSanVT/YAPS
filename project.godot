[internationalization]

locale/translations=PackedStringArray("res://localization/YAPS_Localization.en.translation", "res://localization/YAPS_Localization.pt.translation")

[physics]

3d/physics_engine="Dummy"

[rendering]

textures/canvas_textures/default_texture_filter=2
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/default_filters/anisotropic_filtering_level=1
environment/subsurface_scattering/subsurface_scattering_quality=0
lights_and_shadows/positional_shadow/atlas_quadrant_0_subdiv=0
